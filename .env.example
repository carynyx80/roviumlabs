# ─────────────────────────────────────────────────────────────────────────────
# RoviumPad environment. Copy to `.env` and fill in. Never commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle — never put
# secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required). Local default matches `npm run db:dev`.
DATABASE_URL="postgresql://rovium:rovium@localhost:5433/roviumpad?schema=public"
# Public base URL of the web app (used in token metadata URIs and links).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# ≥32 random characters. REQUIRED in production (generate: openssl rand -base64 48).
SESSION_SECRET=""
# Session lifetime in hours (default 72).
SESSION_TTL_HOURS=72
# Comma-separated wallet addresses that receive the ADMIN role on sign-in.
ADMIN_WALLETS=""

# ── Background jobs ──────────────────────────────────────────────────────────
# Optional. When set, the queue uses Redis + BullMQ; otherwise a PostgreSQL queue.
REDIS_URL=""
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=8081
# Hard timeout per research execution (ms).
EXECUTION_TIMEOUT_MS=180000

# ── AI provider (any OpenAI-compatible /chat/completions API) ────────────────
# Leave empty to run without an LLM: research still runs, reports are written
# deterministically, and chat returns retrieved findings only.
# Examples: https://api.openai.com/v1 | https://openrouter.ai/api/v1 |
#           https://api.groq.com/openai/v1 | http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# Set true if the provider supports response_format: json_schema (OpenAI does).
LLM_SUPPORTS_JSON_SCHEMA=false
# Optional embeddings model for vector memory retrieval (e.g. text-embedding-3-small).
LLM_EMBEDDING_MODEL=""
LLM_TIMEOUT_MS=60000
# Retries for transient provider errors (429 rate limit, 5xx, network). Quota/auth errors are never retried.
LLM_MAX_RETRIES=2
# USD per 1M tokens for spend estimates and limits (defaults: OpenAI gpt-4.1-mini list prices).
LLM_PRICE_INPUT_PER_MTOK=0.4
LLM_PRICE_OUTPUT_PER_MTOK=1.6
# Max model turns in an agent's tool-calling research loop (1–12).
AI_MAX_RESEARCH_TURNS=6
# Platform-wide daily AI spend ceiling (USD, estimated). Per-agent limits are set in each agent's settings.
PLATFORM_DAILY_LLM_SPEND_USD=5

# ── Cost & abuse controls ────────────────────────────────────────────────────
CHAT_MESSAGES_PER_HOUR=20
CHAT_DAILY_TOKEN_BUDGET_PER_AGENT=100000
PLATFORM_DAILY_LLM_TOKEN_BUDGET=2000000
MAX_ACTIVE_AGENTS_PER_USER=10

# ── Optional data providers ──────────────────────────────────────────────────
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# ── Chains ───────────────────────────────────────────────────────────────────
# Enabled networks: localhost, robinhood-testnet, robinhood-mainnet.
NEXT_PUBLIC_CHAINS="localhost,robinhood-testnet"
# Mainnet stays disabled unless this is exactly "true" (requires audited contracts).
NEXT_PUBLIC_ENABLE_MAINNET=false
# Browser RPCs (public endpoints; no secrets). Defaults come from docs.robinhood.com/chain/connecting
NEXT_PUBLIC_RPC_URL_LOCALHOST="http://127.0.0.1:8545"
NEXT_PUBLIC_RPC_URL_ROBINHOOD_TESTNET="https://rpc.testnet.chain.robinhood.com"
NEXT_PUBLIC_RPC_URL_ROBINHOOD_MAINNET="https://rpc.mainnet.chain.robinhood.com"
# Server RPCs used for SIWE smart-wallet checks and deployment verification.
# May include provider API keys (e.g. https://robinhood-testnet.g.alchemy.com/v2/<KEY>).
RPC_URL_LOCALHOST=""
RPC_URL_ROBINHOOD_TESTNET=""
RPC_URL_ROBINHOOD_MAINNET=""

# ── Local development helpers ────────────────────────────────────────────────
DEV_PG_PORT=5433
DEV_CHAIN_PORT=8545
LOCAL_RPC="http://127.0.0.1:8545"
TEST_DATABASE_URL="postgresql://rovium:rovium@localhost:5433/roviumpad_test?schema=public"

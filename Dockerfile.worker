# Persistent autonomous-agent worker. Runs separately from the (serverless) web tier.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --include=dev --ignore-scripts && npx prisma generate
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
USER node
EXPOSE 8081
# tsx runs TypeScript directly; the react-server condition lets server-only modules load.
CMD ["npx", "tsx", "--conditions=react-server", "worker/index.ts"]
